{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "AndreasMelone"
  ],
  "contact": {
    "repo": "https://github.com/RaydanOMGr/glowingeyes"
  },
  "license": "${license}",
  "icon": "assets/glowingeyes/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.andreasmelone.glowingeyes.fabric.GlowingEyesFabric"
    ],
    "client": [
      "me.andreasmelone.glowingeyes.fabric.client.GlowingEyesClient"
    ],
    "cardinal-components": [
      "me.andreasmelone.glowingeyes.fabric.common.component.ComponentHandler"
    ]
  },
  "accessWidener": "${mod_id}.accesswidener",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}"
  },
  "custom": {
    "cardinal-components": [
      "glowingeyes:glowingeyes",
      "glowingeyes:playerdata"
    ]
  }
}
